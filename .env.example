APP_ENV=local
APP_LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://partizan:partizan@localhost:5432/partizan
RUNTIME_STORAGE=memory
LLM_PROVIDER=mock
LLM_MODEL=gpt-5.6
SEARCH_PROVIDER=mock
SEARCH_MODEL=gpt-5.6-terra
OPENAI_API_KEY=

# Read-only Telegram community research. Keep unavailable/false until an authorised
# Telegram user session is installed as deployment secrets and a real research smoke
# has been verified. This session is never a publishing credential: Telegram PUBLISH
# readiness remains a separate fail-closed capability.
TELEGRAM_RESEARCH_PROVIDER=unavailable
TELEGRAM_RESEARCH_PUBLIC_READY=false
# TELEGRAM_RESEARCH_API_ID=
# TELEGRAM_RESEARCH_API_HASH=
# TELEGRAM_RESEARCH_SESSION=
TELEGRAM_RESEARCH_RESULT_LIMIT=5
TELEGRAM_RESEARCH_KNOWN_HANDLE_LIMIT=3
TELEGRAM_RESEARCH_RECENT_MESSAGE_LIMIT=4

# Customer-owned Telegram publishing is a separate capability from research.
# Customer user sessions are generated by the server login flow and encrypted at rest;
# never place a customer StringSession in this environment file. Keep public readiness
# false until provider/API readiness and a real production publish have been verified.
TELEGRAM_CLIENT_PUBLISH_PROVIDER=unavailable
TELEGRAM_CLIENT_PUBLISH_PUBLIC_READY=false
# TELEGRAM_CLIENT_PUBLISH_API_ID=
# TELEGRAM_CLIENT_PUBLISH_API_HASH=

# Customer-owned Reddit publishing is separate from indexed Reddit research. Keep the
# provider unavailable and public readiness false until Partizan's Reddit commercial/API
# access has been explicitly verified and an approved production execution mechanism is
# configured. Customer OAuth access/refresh tokens are encrypted at rest and never belong
# in this environment file.
REDDIT_CLIENT_PUBLISH_PROVIDER=unavailable
REDDIT_CLIENT_PUBLISH_PUBLIC_READY=false
REDDIT_COMMERCIAL_ACCESS_VERIFIED=false
# REDDIT_CLIENT_PUBLISH_CLIENT_ID=
# REDDIT_CLIENT_PUBLISH_CLIENT_SECRET=
# REDDIT_CLIENT_PUBLISH_USER_AGENT=

# Paid IMAGE generation is disabled by default. Set to openai to enable GPT Image.
CREATIVE_PROVIDER=unavailable
CREATIVE_IMAGE_MODEL=gpt-image-2
CREATIVE_IMAGE_QUALITY=medium
GEMINI_API_KEY=
# Paid TikTok VIDEO generation is disabled by default. Set to gemini_omni to enable it.
CREATIVE_VIDEO_PROVIDER=unavailable
CREATIVE_VIDEO_MODEL=gemini-omni-flash-preview
EXECUTION_PROVIDER=mock
OPERATOR_AUTH_REQUIRED=false
OPERATOR_API_KEY=
# Optional absolute origin used for tracking redirects and public creative blobs,
# e.g. https://partizan.example.com. Required by autonomous image/video providers,
# first-click tracking, Stripe Checkout return URLs and Meta/Reddit OAuth callbacks.
PARTIZAN_PUBLIC_BASE_URL=
# Optional Product UUID used only for first-party Partizan-on-Partizan attribution.
# This does not enable paid execution or bypass Growth Balance settlement readiness.
PARTIZAN_SELF_DOGFOOD_PRODUCT_ID=

# Customer monetization. Keep all secret values in deployment secrets, never in git.
# STRIPE_LAUNCH_PRICE_ID points to the optional $49 one-time Acquisition Plan.
# Autonomous execution has no monthly subscription: Partizan earns 10% of actual
# acquisition spend from the customer's prepaid Growth Balance.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LAUNCH_PRICE_ID=
PARTIZAN_LAUNCH_PRICE_USD=49
PARTIZAN_MANAGED_SPEND_FEE_PCT=10

# Growth Balance settlement. Keep unavailable until Stripe Issuing is activated and
# Partizan has prefunded enough Issuing liquidity to cover delegated customer spend.
# STRIPE_ISSUING_CARDHOLDER_ID is a Partizan-owned company cardholder. Partizan creates
# one virtual advertising-only card per customer project; customers never provide their
# own ad billing card. The two webhook secrets belong to separate Stripe webhook endpoints.
GROWTH_BALANCE_SETTLEMENT_PROVIDER=unavailable
STRIPE_ISSUING_CARDHOLDER_ID=
STRIPE_ISSUING_CURRENCY=usd
STRIPE_ISSUING_AUTHORIZATION_WEBHOOK_SECRET=
STRIPE_ISSUING_EVENTS_WEBHOOK_SECRET=
STRIPE_ISSUING_WEBHOOK_API_VERSION=2025-03-31.basil

# Self-service Meta connection for customer Autopilot. The API version is explicit
# so deployments can upgrade deliberately instead of silently following a moving default.
# Generate PROVIDER_SECRET_ENCRYPTION_KEY with Fernet.generate_key() and keep it stable.
# It also encrypts customer-owned Telegram sessions and Reddit OAuth token bundles when
# those capabilities are independently enabled.
PROVIDER_SECRET_ENCRYPTION_KEY=
META_OAUTH_APP_ID=
META_OAUTH_APP_SECRET=
META_OAUTH_API_VERSION=
META_OAUTH_PUBLIC_READY=false

# Owned SMTP sender. Outreach remains fail-closed until all sender identity fields are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_REPLY_TO=
SMTP_STARTTLS=true

# Docker/production runtime. Production compose forces APP_ENV=production and
# RUNTIME_STORAGE=database. Use strong deployment-only values in .env.prod.
POSTGRES_PASSWORD=partizan
CONTAINER_DATABASE_URL=postgresql+asyncpg://partizan:partizan@postgres:5432/partizan
PARTIZAN_API_PORT=8000
PAID_CONTROL_INTERVAL_SECONDS=60
AUTONOMOUS_GROWTH_INTERVAL_SECONDS=300

# Operator-managed paid-provider tokens can still be supplied through environment
# references. Customer-connected Meta tokens use encrypted RuntimeStateStore records
# and are hydrated into the existing env-ref execution boundary only in process memory.
# META_PRODUCT_ACCESS_TOKEN=
# TIKTOK_PRODUCT_ACCESS_TOKEN=
