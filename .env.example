APP_ENV=local
APP_LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://partizan:partizan@localhost:5432/partizan
RUNTIME_STORAGE=memory
LLM_PROVIDER=mock
LLM_MODEL=gpt-5.6
SEARCH_PROVIDER=mock
SEARCH_MODEL=gpt-5.6-terra
OPENAI_API_KEY=
EXECUTION_PROVIDER=mock
OPERATOR_AUTH_REQUIRED=false
OPERATOR_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# Docker/production runtime. docker-compose.yml forces RUNTIME_STORAGE=database
# for both API and the paid-control worker. APP_ENV=production also makes
# OPERATOR_API_KEY mandatory on sensitive execution/control endpoints.
POSTGRES_PASSWORD=partizan
CONTAINER_DATABASE_URL=postgresql+asyncpg://partizan:partizan@postgres:5432/partizan
PARTIZAN_API_PORT=8000
PAID_CONTROL_INTERVAL_SECONDS=60

# Paid-provider access tokens are not stored in Partizan. Add token values to
# deployment secrets/environment under the exact env-var names configured on
# each Meta/TikTok paid-provider connection, for example:
# META_ORACLE_ACCESS_TOKEN=
# TIKTOK_ORACLE_ACCESS_TOKEN=
